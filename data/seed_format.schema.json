{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What Fits seed device v0.1",
  "type": "object",
  "required": ["brand", "category", "canonical_name", "model_code", "market", "source_checked_at", "replacements"],
  "properties": {
    "brand": {"type": "string", "minLength": 1},
    "category": {"type": "string", "enum": ["printer"]},
    "canonical_name": {"type": "string", "minLength": 1},
    "model_code": {"type": "string", "minLength": 1},
    "family": {"type": ["string", "null"]},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "market": {"type": "string", "enum": ["RU"]},
    "lifecycle_status": {"type": "string", "enum": ["current", "legacy", "unknown"]},
    "source_checked_at": {"type": "string", "format": "date"},
    "replacements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "part_number", "canonical_name", "status", "source"],
        "properties": {
          "type": {"type": "string", "enum": ["toner_cartridge", "ink", "drum_unit"]},
          "part_number": {"type": "string", "minLength": 1},
          "canonical_name": {"type": "string", "minLength": 1},
          "yield_pages": {"type": ["integer", "null"], "minimum": 1},
          "color": {"type": ["string", "null"]},
          "status": {"type": "string", "enum": ["VERIFIED", "VERIFIED_THIRD_PARTY", "SPEC_MATCH", "UNVERIFIED", "UNDER_REVIEW"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "conditions": {"type": "object"},
          "source": {
            "type": "object",
            "required": ["type", "publisher", "title", "url", "market", "checked_at"],
            "properties": {
              "type": {"type": "string"},
              "publisher": {"type": "string"},
              "title": {"type": "string"},
              "url": {"type": "string", "format": "uri"},
              "market": {"type": "string"},
              "checked_at": {"type": "string", "format": "date"},
              "note": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
